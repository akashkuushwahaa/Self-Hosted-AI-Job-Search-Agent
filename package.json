{
  "name": "shortlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.mts",
    "embed": "tsx --env-file-if-exists=.env scripts/embed.mts",
    "eval:match": "tsx --env-file-if-exists=.env evals/match/run.mts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.mts",
    "mcp": "tsx --env-file-if-exists=.env scripts/mcp.mts",
    "smoke": "tsx scripts/smoke.mts",
    "demo:seed": "tsx --env-file-if-exists=.env scripts/demo-seed.mts",
    "demo:build": "tsx --env-file-if-exists=.env scripts/build-demo.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-pgvector": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "pg-boss": "^12.39.0",
    "playwright": "^1.65.1",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}

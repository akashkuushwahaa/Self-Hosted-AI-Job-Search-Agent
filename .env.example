DATABASE_URL=postgres://shortlist:shortlist@localhost:5432/shortlist
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: GitHub sign-in. Create an OAuth app with callback http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Ollama for embeddings (defaults shown)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:7b

# Worker: daily ingest → embed → score (cron, in this machine's time zone). "off" turns it off.
REFRESH_CRON="0 6 * * *"

# Who may create an account (lib/signup.ts). Open when both are unset, fine for a local install.
# On a public server, set one: ALLOW_SIGNUP=0 closes sign-up; ALLOWED_EMAILS lets in only these.
# ALLOW_SIGNUP=0
# ALLOWED_EMAILS=you@example.com,@yourteam.dev

# Optional email sender, for password reset only. Unset: "Forgot password?" is hidden.
# Any SMTP server, e.g. smtp://user:pass@smtp.example.com:587 (smtps:// for 465).
# SMTP_URL=log prints reset links to the server console instead (fine for a local install).
# SMTP_URL=
# MAIL_FROM="Shortlist <shortlist@example.com>"

# Time zone for the worker's daily run (REFRESH_CRON). Docker containers default to UTC.
# TZ=Asia/Kolkata
# Docker only: where the containers reach Ollama. Default: Ollama on the host machine.
# OLLAMA_DOCKER_URL=http://ollama:11434
